# STM32CubeIDE / STM32CubeMX
.metadata/
.settings/
Debug/
Release/
*.launch
*.ioc.bak

# Build products
build/
*.elf
*.hex
*.bin
*.map
*.o
*.d

# Python
__pycache__/
*.py[cod]
.venv/

# Generated plots and local logs
data/raw/*
!data/raw/.gitkeep
# 例外：2026-09-02 L1 霍尔实测原始证据（sigrok .sr/.pvs、波形与距离 PNG，共约 574KB；
# 无设备序列号等敏感信息）。作为不可改写、团队可复核的证据纳入版本控制，对应 PR #51。
!data/raw/2026-09-02/
!data/raw/2026-09-02/*
# 例外：2026-09-03 Issue #6 双路 L1 串扰原始证据（sigrok .sr/.pvs、波形 PNG）。
!data/raw/2026-09-03/
!data/raw/2026-09-03/*
data/processed/*
!data/processed/.gitkeep

# Temporary hardware photo inbox
Pictures/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*
