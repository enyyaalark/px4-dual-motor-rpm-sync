# STM32CubeIDE / STM32CubeMX
.metadata/
.settings/
Debug/
Release/
*.launch
*.ioc.bak

# Build products
build/
*.elf
*.hex
*.bin
*.map
*.o
*.d

# Python
__pycache__/
*.py[cod]
.venv/

# Generated plots and local logs
data/raw/*
!data/raw/.gitkeep
# 例外：2026-09-02 L1 霍尔实测原始证据（sigrok .sr/.pvs、波形与距离 PNG，共约 574KB；
# 无设备序列号等敏感信息）。作为不可改写、团队可复核的证据纳入版本控制，对应 PR #51。
!data/raw/2026-09-02/
!data/raw/2026-09-02/*
# 例外：2026-09-03 Issue #6 双路 L1 串扰原始证据（sigrok .sr/.pvs、波形 PNG）。
!data/raw/2026-09-03/
!data/raw/2026-09-03/*
# 例外：2026-09-04 Issue #6 双路 Hall 捕获 UART 原始证据，仅纳入有效四项
# （无脉冲/Hall1/Hall2/复位双路；无串口设备名或序列号）。旧/无效与空文件不纳入。
!data/raw/2026-09-04/
data/raw/2026-09-04/*
!data/raw/2026-09-04/issue-6-no-pulse-043732.txt
!data/raw/2026-09-04/issue-6-ch1-manual-retry-044202.txt
!data/raw/2026-09-04/issue-6-ch2-manual-retry-044527.txt
!data/raw/2026-09-04/issue-6-dual-restart-050637.txt
# 例外：2026-09-10 Issue #8 拆桨 PPR 多点标定的六个有效 UART 周期记录。
# 文件名保留现场原名；电机/转速点映射见 processed sources CSV。
!data/raw/2026-09-10/
data/raw/2026-09-10/*
!data/raw/2026-09-10/m1_p1_r8.txt
!data/raw/2026-09-10/m1_p2_r11.txt
!data/raw/2026-09-10/m1_p2_r12.txt
!data/raw/2026-09-10/m1_p2_r13.txt
!data/raw/2026-09-10/m1_p2_r17.txt
!data/raw/2026-09-10/m1_p2_r20.txt
# 例外：2026-09-11 Issue #7 当前 main/v2 的双路稳定旋转与停止归零 UART 证据。
!data/raw/2026-09-11/
data/raw/2026-09-11/*
!data/raw/2026-09-11/issue-7-dual-stop-v2-run1.txt
!data/raw/2026-09-11/issue-7-dual-stop-v2-run2.txt
data/processed/*
!data/processed/.gitkeep
!data/processed/2026-09-10-ppr-calibration-input.csv
!data/processed/2026-09-10-ppr-calibration-results.csv
!data/processed/2026-09-10-ppr-calibration-sources.csv

